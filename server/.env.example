# Copy to server/.env and fill in YOUR OWN values. Never commit server/.env.
# Every name below is read by server/src/config/env.ts (or the file named next to it).

# --- Server / database ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/nexus-ai
# Required in production (the server refuses to start without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Video meetings (LiveKit) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
MAX_MEETING_PARTICIPANTS=5
MEETING_RECONNECT_GRACE_MS=20000

# --- Feature switches ---
ENABLE_MEETING_TRANSCRIPTION=true
ENABLE_MEETING_AI=false
ENABLE_NEXUS_AI=true

# --- AI (Gemini): summaries, Ask NEXUS, translation ---
LLM_API_KEY=your-gemini-api-key
# Run `npx ts-node --transpile-only scripts/verify/llmModels.ts` to list the model names your key can use.
LLM_MODEL=gemini-flash-latest
# LLM_TIMEOUT_MS=28000
# LLM_THINKING=off
# LLM_BASE_URL=            (only for tests or a proxy)
VOYAGE_API_KEY=your-voyage-api-key

# --- Live speech-to-text: self-hosted Whisper service (see stt-service/README.md) ---
WHISPER_URL=http://127.0.0.1:9000
# Optional shared secret; must be identical in the terminal that runs stt-service. Needed only if the service
# is reachable by anyone other than this machine.
WHISPER_API_TOKEN=
WHISPER_LANGUAGES=en,ta,hi,ar
WHISPER_CODE_SWITCH_PROMPT=true
WHISPER_HOTWORDS=
WHISPER_ENDPOINT_SILENCE_MS=700
WHISPER_MAX_UTTERANCE_MS=25000
WHISPER_MIN_SPEECH_MS=200
WHISPER_PARTIALS_MS=0
WHISPER_REQUEST_TIMEOUT_MS=60000
WHISPER_MAX_PENDING=10
WHISPER_TIMING_LOG=true
STT_VOICE_RMS=150
STT_SILENCE_HANGOVER_MS=2500
STT_IDLE_CLOSE_MS=60000
STT_MAX_CONCURRENT_SESSIONS=50
STT_MIN_CONFIDENCE=0.5

# --- Recorded-file upload path ---
# whisper = self-hosted (no key, no speaker labels); assemblyai = paid API (needs STT_API_KEY); none = disabled
STT_PROVIDER=none
STT_API_KEY=
WHISPER_FILE_TIMEOUT_MS=3600000
MAX_UPLOAD_MB=200
UPLOAD_DIR=uploads
